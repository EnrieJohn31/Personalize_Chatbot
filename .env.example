APP_NAME="Assistant Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
VITE_PORT=5173
VITE_USE_POLLING=true
WWWUSER=1000
WWWGROUP=1000
AGENT_URL=http://agent:3101
# Laravel signs private engine requests with this key; Compose passes the same value to the
# engine. setup.ps1 generates it. Leave empty only to keep the engine's run endpoints closed.
AGENT_REQUEST_SIGNING_KEY=
# Development only: lets the engine admit the deterministic simulated provider, and sets the
# pause between its streamed chunks (0–1000 ms).
AGENT_SIMULATION_ENABLED=true
AGENT_SIMULATION_CHUNK_DELAY_MS=35
# Engine only: encrypts stored provider sign-ins and API keys (at least 32 characters;
# setup.ps1 generates it). Changing it makes them unreadable, so users must connect again.
AGENT_CREDENTIAL_KEY=
# Models used by Connections > Send test message. The OpenCode defaults are free models.
ASSISTANT_CONNECTION_TEST_MODEL=gpt-5.4-mini
ASSISTANT_OPENCODE_GO_TEST_MODEL=beam-free
ASSISTANT_OPENCODE_ZEN_TEST_MODEL=beam-free
# Optional local model server with an OpenAI-compatible API, offered to every user. Examples:
#   Ollama on this computer:     http://host.docker.internal:11434/v1  (on Linux, start Ollama with OLLAMA_HOST=0.0.0.0)
#   LM Studio on this computer:  http://host.docker.internal:1234/v1
#   A server on the local network: http://192.168.1.20:8000/v1
# While LOCAL_LLM_URL is empty the card shows "Not set up". Recreate the engine after changing
# these (docker compose up -d agent); LOCAL_LLM_API_KEY only if the server requires a key.
LOCAL_LLM_URL=
LOCAL_LLM_NAME=
LOCAL_LLM_API_KEY=
# Model used by its test message; empty uses the first model the server lists.
LOCAL_LLM_TEST_MODEL=
# Chat replies use each conversation's chosen connection and model; false falls back to the
# built-in assistant for every chat. Reasoning effort for models that reason: low, medium or high.
ASSISTANT_LIVE_REPLIES=true
ASSISTANT_REASONING=medium

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=assistant_foundation
DB_USERNAME=sail
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

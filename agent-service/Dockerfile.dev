FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

WORKDIR /app
# /var/lib/agent holds the installation ID and encrypted sign-ins; a new named volume copies this ownership.
RUN chown node:node /app && install -d -o node -g node -m 700 /var/lib/agent
USER node
COPY --chown=node:node package.json package-lock.json .npmrc ./
RUN npm ci --no-fund
COPY --chown=node:node tsconfig.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node tests ./tests
# Shared request/event schemas from the repository's contracts/ directory (a named build context).
COPY --from=contracts --chown=node:node . /contracts
RUN npm run build

# 3101 serves Laravel on the private network; 1455 receives the provider's sign-in redirect.
EXPOSE 3101 1455
CMD ["npm", "run", "dev"]

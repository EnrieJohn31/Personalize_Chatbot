{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:assistant-foundation:contracts:v1:run-event",
    "title": "Engine run event",
    "description": "One normalized engine event. Provider-specific frames are mapped to these types before they leave the engine. Tool and source events report the run's tool calls (task 3.3); they never carry tool arguments or result text.",
    "type": "object",
    "additionalProperties": false,
    "required": ["contractVersion", "runId", "sequence", "type", "data"],
    "properties": {
        "contractVersion": { "const": 1 },
        "runId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequence": {
            "description": "Monotonic per-run engine sequence starting at 1.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
        },
        "type": {
            "enum": [
                "run.started",
                "run.progress",
                "tool.started",
                "tool.finished",
                "source.added",
                "assistant.delta",
                "assistant.final",
                "run.completed",
                "run.failed",
                "run.cancelled"
            ]
        },
        "data": { "type": "object" }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "type": {
                        "enum": [
                            "run.started",
                            "run.completed",
                            "run.cancelled"
                        ]
                    }
                }
            },
            "then": { "properties": { "data": { "$ref": "#/$defs/empty" } } }
        },
        {
            "if": { "properties": { "type": { "const": "run.progress" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/progress" } } }
        },
        {
            "if": { "properties": { "type": { "const": "assistant.delta" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/delta" } } }
        },
        {
            "if": { "properties": { "type": { "const": "assistant.final" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/final" } } }
        },
        {
            "if": { "properties": { "type": { "const": "run.failed" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/failure" } } }
        },
        {
            "if": { "properties": { "type": { "const": "tool.started" } } },
            "then": {
                "properties": { "data": { "$ref": "#/$defs/toolStarted" } }
            }
        },
        {
            "if": { "properties": { "type": { "const": "tool.finished" } } },
            "then": {
                "properties": { "data": { "$ref": "#/$defs/toolFinished" } }
            }
        },
        {
            "if": { "properties": { "type": { "const": "source.added" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/source" } } }
        }
    ],
    "$defs": {
        "toolCallId": {
            "description": "The provider's ID for one tool call; it pairs the call with its result.",
            "type": "string",
            "pattern": "^[\\x21-\\x7e]{1,256}$"
        },
        "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "toolStarted": {
            "description": "A permitted tool call passed its checks and started running.",
            "type": "object",
            "additionalProperties": false,
            "required": ["toolCallId", "name"],
            "properties": {
                "toolCallId": { "$ref": "#/$defs/toolCallId" },
                "name": { "$ref": "#/$defs/toolName" }
            }
        },
        "toolFinished": {
            "description": "How a tool call the model made ended. blocked: not permitted, a repeat or over the run's tool budget; invalid_arguments: refused before running; failed and timeout: it ran without a result. Only ok and failed or timeout calls were started.",
            "type": "object",
            "additionalProperties": false,
            "required": ["toolCallId", "name", "outcome", "message"],
            "properties": {
                "toolCallId": { "$ref": "#/$defs/toolCallId" },
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "outcome": {
                    "enum": [
                        "ok",
                        "blocked",
                        "invalid_arguments",
                        "failed",
                        "timeout"
                    ]
                },
                "message": {
                    "anyOf": [
                        { "type": "null" },
                        { "type": "string", "minLength": 1, "maxLength": 500 }
                    ]
                }
            }
        },
        "source": {
            "description": "Evidence a tool result used, kept apart from the text the model read.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "toolCallId",
                "evidenceId",
                "title",
                "locator",
                "checkedAt"
            ],
            "properties": {
                "toolCallId": { "$ref": "#/$defs/toolCallId" },
                "evidenceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                },
                "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                },
                "checkedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            }
        },
        "empty": { "type": "object", "additionalProperties": false },
        "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage"],
            "properties": {
                "stage": { "enum": ["preparing", "retrieving", "answering"] }
            }
        },
        "delta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 16384 }
            }
        },
        "final": {
            "description": "Complete answer text. It replaces any accumulated deltas; it is never appended to them.",
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "text": { "type": "string", "maxLength": 200000 } }
        },
        "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
                "code": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                }
            }
        }
    }
}
